root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,json,jsonc,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in markdown; the global trim would eat them.
trim_trailing_whitespace = false
